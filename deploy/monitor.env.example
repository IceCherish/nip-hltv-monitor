# 复制为 /opt/nip-hltv-monitor/monitor.env，并只允许 root 读取。
QQ_GROUP_ID=123456789
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=请换成随机长字符串

NEWS_MODE=all
REMINDER_MINUTES=30
CHECK_INTERVAL_SECONDS=360

# auto：有腾讯密钥就走腾讯翻译，否则走 Google 免费接口。
TRANSLATE_PROVIDER=auto
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-beijing
