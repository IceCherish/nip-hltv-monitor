[Unit]
Description=NIP and HLTV QQ monitor
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nip-hltv-monitor
EnvironmentFile=/opt/nip-hltv-monitor/monitor.env
ExecStart=/usr/bin/python3 /opt/nip-hltv-monitor/run_forever.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
