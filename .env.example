# 复制本文件为 .env；中继服务器至少修改前三项，其余按需填写。
QQ_GROUP_ID=在这里填QQ群号
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=在这里填NapCat的HTTP服务Token

NEWS_MODE=all
REMINDER_MINUTES=30
SCHEDULE_LOOKAHEAD_DAYS=7
CHECK_INTERVAL_SECONDS=900
TRANSLATE_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# GitHub Actions 中继模式：只在 GitHub Secrets 配置，不用于本机直连。
RELAY_URL=
RELAY_SECRET=

# Groq 不可用时依次降级到腾讯和 Google；腾讯配置可留空。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-beijing
TENCENT_TERM_REPO_ID=
