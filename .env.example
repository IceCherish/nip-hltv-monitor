# 复制本文件为 .env，只修改前三项。
QQ_GROUP_ID=在这里填QQ群号
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=在这里填NapCat的HTTP服务Token

NEWS_MODE=all
REMINDER_MINUTES=30
CHECK_INTERVAL_SECONDS=360
TRANSLATE_PROVIDER=auto

# 国内服务器需要腾讯翻译时再填；本机测试可以留空。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-beijing
